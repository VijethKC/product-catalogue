# API
PORT=4000
NODE_ENV=development

# Product data source
FAKE_STORE_BASE_URL=https://fakestoreapi.com
FAKE_STORE_TIMEOUT_MS=5000

# The five products the entrepreneur has chosen as "top rated" (Fake Store IDs)
FEATURED_PRODUCT_IDS=1,2,3,4,5

# How many top-rated products each category page shows before the rest
FEATURED_PER_CATEGORY=3

# SMTP (Mailpit locally; swap for SES/Resend credentials in production)
# Mailpit UI: http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=sales@productcatalogue.local
EMAIL_TO=sales-inbox@productcatalogue.local

# Docker Compose host ports (docker-compose.yml)
WEB_PORT=8080
API_PORT=4000
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
